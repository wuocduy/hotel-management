@{ Layout = "_AuthLayout"; ViewData["Title"] = "Đăng nhập"; }
<div class="auth-card">
    <div class="auth-heading"><p>CHÀO MỪNG TRỞ LẠI</p><h1>Đăng nhập</h1><span>Đăng nhập để quản lý Aurora Hotel.</span></div>
    <form class="auth-form" data-demo-form data-demo-message="Đây là giao diện demo. Thông tin chưa được gửi hoặc lưu vào hệ thống.">
        <label for="login-email">Email</label>
        <input id="login-email" name="email" type="email" autocomplete="email" placeholder="name@hotel.com" required />
        <label for="login-password">Mật khẩu</label>
        <input id="login-password" name="password" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu" minlength="8" required />
        <button class="auth-submit" type="submit">Đăng nhập</button>
        <p class="demo-message" hidden role="status"></p>
    </form>
    <p class="auth-switch">Chưa có tài khoản? <a asp-controller="Auth" asp-action="Register">Đăng ký ngay</a></p>
</div>
