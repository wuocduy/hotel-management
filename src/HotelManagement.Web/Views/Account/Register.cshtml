@using HotelManagement.Application.DTOs.Authentication
@model RegisterRequest
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Đăng ký"; }
<div class="auth-card">
    <div class="auth-heading"><p>BẮT ĐẦU VỚI AURORA</p><h1>Tạo tài khoản</h1><span>Thiết lập tài khoản quản lý khách sạn của bạn.</span></div>
    <form method="post" class="auth-form">
        <div asp-validation-summary="ModelOnly" class="form-error"></div>
        <label asp-for="FullName">Họ và tên</label>
        <input asp-for="FullName" autocomplete="name" placeholder="Nguyễn Minh Anh" />
        <span asp-validation-for="FullName" class="field-error"></span>
        <label asp-for="Email">Email</label>
        <input asp-for="Email" autocomplete="email" placeholder="name@hotel.com" />
        <span asp-validation-for="Email" class="field-error"></span>
        <label asp-for="Password">Mật khẩu</label>
        <input asp-for="Password" autocomplete="new-password" placeholder="Tối thiểu 8 ký tự" />
        <span asp-validation-for="Password" class="field-error"></span>
        <label asp-for="ConfirmPassword">Xác nhận mật khẩu</label>
        <input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Nhập lại mật khẩu" />
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        <button class="auth-submit" type="submit">Tạo tài khoản</button>
    </form>
    <p class="auth-switch">Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p>
</div>
