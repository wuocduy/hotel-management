@using HotelManagement.Application.DTOs.Authentication
@model LoginRequest
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Đăng nhập"; }
<div class="auth-card">
    <div class="auth-heading"><p>CHÀO MỪNG TRỞ LẠI</p><h1>Đăng nhập</h1><span>Đăng nhập để quản lý Aurora Hotel.</span></div>
    <form method="post" class="auth-form">
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
        <div asp-validation-summary="ModelOnly" class="form-error"></div>
        <label asp-for="Email">Email</label>
        <input asp-for="Email" autocomplete="email" placeholder="name@hotel.com" />
        <span asp-validation-for="Email" class="field-error"></span>
        <label asp-for="Password">Mật khẩu</label>
        <input asp-for="Password" autocomplete="current-password" placeholder="Nhập mật khẩu" />
        <span asp-validation-for="Password" class="field-error"></span>
        <button class="auth-submit" type="submit">Đăng nhập</button>
    </form>
    <p class="auth-switch">Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a></p>
</div>
